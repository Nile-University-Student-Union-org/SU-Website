# ── Auth ──────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=""   # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="nusu"
POSTGRES_PORT="5432"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nusu"

# ── Super-admin seed ──────────────────────────────────────────────────────────
# Created by `pnpm seed` on first run if no user with this email exists.
SUPER_ADMIN_EMAIL="superadmin@nusu.edu"
SUPER_ADMIN_PASSWORD="ChangeMe!2026"
SUPER_ADMIN_NAME="Super Admin"

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
# Local dev: `docker compose up -d` starts MinIO at http://localhost:9000
#            Web console at http://localhost:9001  (user: minioadmin / minioadmin)
# Production: remove AWS_S3_ENDPOINT and replace the values below with real AWS credentials.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_S3_BUCKET="nusu"
AWS_S3_ENDPOINT="http://localhost:9000"      # MinIO only — remove for real AWS
AWS_S3_PUBLIC_URL="http://localhost:9000/nusu"
